# Copy to .env and replace every development value before use beyond a local machine.
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=local-only-change-this-database-password
POSTGRES_PORT=5432
JWT_ISSUER=ECommerce.Api
JWT_AUDIENCE=ECommerce.Client
JWT_SECRET_KEY=local-only-change-this-to-a-random-secret-at-least-32-bytes
JWT_EXPIRATION_MINUTES=15
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CLIENT_APP_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGIN=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Local-Only-Admin-Password-Change-123!
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Administrator
SEED_ENABLED=true
SEED_CUSTOMER_PASSWORD=Customer123!
API_PORT=8080
FRONTEND_PORT=3010
EMAIL__HOST=smtp-relay.brevo.com
EMAIL__PORT=587
EMAIL__USERNAME=beb434001@smtp-brevo.com
EMAIL__PASSWORD=your_brevo_smtp_key_here
EMAIL__FROMEMAIL=your_verified_sender@example.com
EMAIL__FROMNAME=ECommerce
EMAIL__USESTARTTLS=true
PRODUCT_EXPORT_RECIPIENT=admin@example.com
PRODUCT_EXPORT_CRON="0 8 * * *"
# Explicitly enable the no-card, simulated checkout in local/test environments only.
PAYMENTS__SANDBOX__ENABLED=true
